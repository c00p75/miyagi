{
  "name": "miyagi-mcp",
  "version": "3.0.0",
  "description": "A patient, gamified, voice-enabled MCP coding tutor. You run the commands; it drills, corrects, and keeps score.",
  "type": "module",
  "bin": {
    "miyagi": "dist/miyagi.js",
    "miyagi-mcp": "dist/miyagi.js"
  },
  "main": "dist/miyagi.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/miyagi.js",
    "start": "node dist/miyagi.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "eval": "tsc -p tsconfig.test.json && node --test dist-test/test/quality.test.js dist-test/test/journey.test.js dist-test/test/coverage.test.js",
    "doctor": "node dist/miyagi.js --doctor",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "author": "George M'sapenda",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "tutor",
    "education",
    "learning",
    "gamification",
    "text-to-speech",
    "tts",
    "cli",
    "roadmap",
    "claude",
    "cursor",
    "ai"
  ],
  "homepage": "https://github.com/c00p75/miyagi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c00p75/miyagi.git"
  },
  "bugs": {
    "url": "https://github.com/c00p75/miyagi/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
